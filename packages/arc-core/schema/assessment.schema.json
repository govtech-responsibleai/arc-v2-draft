{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/govtech-responsibleai/arc-v2-draft/main/packages/arc-core/schema/assessment.schema.json",
  "title": "ARC assessment",
  "description": "An assessment of one agentic AI system under the ARC Framework (format arcvisor/assessment, version 1). Written by ARCvisor and the arc-assessment skill.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "arcvisor/assessment"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "register": {
      "description": "Register the assessment was last worked against",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "sample": {
      "type": [
        "string",
        "null"
      ]
    },
    "pasted": {
      "description": "Description pasted in to draft the system answers",
      "type": "string"
    },
    "repoUrl": {
      "type": "string"
    },
    "system": {
      "default": {},
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "deployment": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "autonomy": {
          "type": "string"
        },
        "dataClassification": {
          "type": "string"
        },
        "pii": {
          "type": "string"
        },
        "publicFacing": {
          "type": "string"
        },
        "criticality": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "string",
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "description": "Relevance preset from the governance guide"
    },
    "caps": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "present": {
            "type": "string",
            "enum": [
              "yes",
              "unsure",
              "no"
            ],
            "description": "yes: present; unsure: counted as present until decided; no: absent"
          },
          "providedBy": {
            "type": "string"
          },
          "approval": {
            "type": "string",
            "enum": [
              "",
              "always",
              "some",
              "never"
            ],
            "description": "Whether a person approves before the capability acts"
          },
          "reason": {
            "description": "Why it is present or absent, especially for capabilities ruled out",
            "type": "string"
          },
          "evidence": {
            "description": "File paths, with line numbers where useful",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "description": "The authority it is used at. Unstated: the highest the capability allows",
            "type": "string",
            "enum": [
              "read",
              "propose",
              "act-with-approval",
              "act-alone"
            ]
          },
          "irreversible": {
            "description": "Whether its effects can be undone. Unstated where the register asks: irreversible",
            "type": "boolean"
          },
          "external": {
            "description": "Whether its effects reach outside the organisation. Unstated where the register asks: external",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "present": {
            "type": "string",
            "enum": [
              "yes",
              "unsure",
              "no"
            ],
            "description": "yes: present; unsure: counted as present until decided; no: absent"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "context": {
            "description": "How the risk would arise in this system",
            "type": "string"
          },
          "impact": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "likelihood": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "impactReason": {
            "type": "string"
          },
          "likelihoodReason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "as-is",
              "adapted",
              "not-adopted",
              "waived"
            ],
            "description": "Level 0 controls allow only as-is, or waived when the specific thing the control concerns is not present in the system (with the evidence); Levels 1 and 2 allow as-is, adapted or not adopted"
          },
          "how": {
            "description": "How it is implemented: what, where, thresholds",
            "type": "string"
          },
          "evidence": {
            "description": "What a reviewer can check: config, test, log query, review record",
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "reason": {
            "description": "Why a Level 1 or 2 control is not adopted, or what is absent for a waived Level 0 control",
            "type": "string"
          },
          "proposal": {
            "description": "Proposed change for a gap",
            "type": "string"
          },
          "contradictionAccepted": {
            "description": "A reviewer accepted the explanation for a code check that contradicts this entry",
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "by",
              "reason",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "residual": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "accept",
              "monitor",
              "mitigate"
            ]
          },
          "actions": {
            "type": "string"
          },
          "impact": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "likelihood": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "acceptedBy": {
