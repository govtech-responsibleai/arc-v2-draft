{
  "name": "arc-website",
  "private": true,
  "type": "module",
  "description": "The ARC Framework website, built with Astro Starlight from docs/ and arc-risk-register/.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "content": "${PYTHON:-python3} ../scripts/build_site.py",
    "dev": "npm run content && (${PYTHON:-python3} ../scripts/build_site.py --watch & astro dev)",
    "build": "npm run content && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.43.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.13",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
