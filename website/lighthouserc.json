{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/arc-v2-draft/",
        "http://localhost:4321/arc-v2-draft/arc_framework/in-five-minutes/",
        "http://localhost:4321/arc-v2-draft/register/risk-034/",
        "http://localhost:4321/arc-v2-draft/explorer/",
        "http://localhost:4321/arc-v2-draft/arc_framework/risk-register/"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
